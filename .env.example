# ── Project Configuration ──────────────────────────────────────────────────
PROJECT_ROOT=path/to/ELIQSIR
DATA_DIR=path/to/ELIQSIR/data
# ── Sub-projects ───────────────────────────────────────────────────────────
IPAI_PROJECT_DIR=path/to/ELIQSIR/ipai_project

# ── API Credentials ────────────────────────────────────────────────────────
# No registration required. NCBI just uses this to identify your script's requests.
NCBI_EMAIL=example@email.com

# ── Data warehouse target database (AWS RDS) ───────────────────────────────
MYSQL_DWH_HOST=host
MYSQL_DWH_PORT=port
MYSQL_DWH_NAME=db
MYSQL_DWH_USER=user
MYSQL_DWH_PASSWORD=password