DRIVE_PATH=/content/drive/MyDrive/path/to/your/data
NCBI_EMAIL=your.email@example.com  # Required by NCBI

# ── MySQL connection (used for BOTH the data warehouse AND ChEMBL) ──────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_username
MYSQL_PASSWORD=your_password

# ── Data warehouse target database ──────────────────────────────────────────
MYSQL_DB=eliqsir_dw

# ── ChEMBL source database ───────────────────────────────────────────────────
# Same server as above; only the database name differs.
CHEMBL_MYSQL_DB=chembl_36
# Directory containing chembl_36_mysql.dmp  (default shown below)
# CHEMBL_DUMP_DIR=data/ChEMBL/chembl_36/chembl_36_mysql